---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { project } from '@/config/project.config';
import { withBase } from '@/lib/base';
import '@/styles/project.css';

const { terminal, sections } = project;
// Headings in config use \n for a line break; render each part with a <br />.
const lines = (text: string) => text.split('\n');
---

<LandingLayout title={project.name} description={project.description}>
  <main id="main-content" class="project-site">
    <section class="project-hero" aria-labelledby="project-title">
      <div class="project-glow" aria-hidden="true"></div>
      <div class="project-shell hero-grid">
        <div class="hero-content">
          <div class="project-eyebrow"><span class="eyebrow-dot"></span>{project.eyebrow}</div>
          <h1 id="project-title">{project.headline}</h1>
          <p class="hero-summary">{project.summary}</p>
          <div class="hero-actions">
            <a class="project-button primary" href={withBase('/docs/getting-started/')}>Get started <Icon name="arrow-up-right" size="sm" /></a>
            <a class="project-button secondary" href={project.repository} target="_blank" rel="noopener noreferrer">View source <Icon name="github" size="sm" /></a>
          </div>
          <div class="hero-meta"><span class="status-dot"></span> {project.versionLabel}{project.heroMeta.map((item) => (<Fragment> <span aria-hidden="true">/</span> {item}</Fragment>))}</div>
        </div>
        <div class="product-preview" aria-label="Example developer experience">
          <div class="window-top"><div class="window-dots" aria-hidden="true"><i></i><i></i><i></i></div><span>{terminal.title}</span><Icon name="terminal" size="sm" /></div>
          <div class="window-body">
            {terminal.commands.map((command) => <div class="terminal-row"><span class="prompt">$</span><span>{command}</span></div>)}
            <div class="terminal-rule"></div>
            <div class="terminal-success"><span class="terminal-pulse"></span> {terminal.status}</div>
            {terminal.lines.map((line) => <div class="terminal-muted">{line}</div>)}
          </div>
          <div class="preview-footer"><span>{terminal.footerLeft}</span><span>{terminal.footerRight}</span></div>
        </div>
      </div>
      <div class="project-shell hero-bottom">{sections.heroFooter.map((item) => <span>{item}</span>)}</div>
    </section>

    <section id="features" class="project-section" aria-labelledby="features-title">
      <div class="project-shell">
        <div class="section-kicker">{sections.features.kicker}</div>
        <div class="section-heading"><h2 id="features-title">{lines(sections.features.heading)[0]}<br /><em>{lines(sections.features.heading)[1]}</em></h2><p>{sections.features.lead}</p></div>
        <div class="feature-grid">
          {project.benefits.map((benefit) => (
            <article class="feature-card">
              <div class="feature-top"><span>{benefit.number}</span><span class="feature-icon"><Icon name={benefit.icon} size="lg" /></span></div>
              <h3>{benefit.title}</h3>
              <p>{benefit.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="workflow" class="project-section section-alt" aria-labelledby="workflow-title">
      <div class="project-shell workflow-grid">
        <div>
          <div class="section-kicker">{sections.workflow.kicker}</div>
          <h2 id="workflow-title">{lines(sections.workflow.heading)[0]}<br />{lines(sections.workflow.heading)[1]}</h2>
          <p class="section-lead">{sections.workflow.lead}</p>
          <a class="project-text-link" href={withBase('/docs/')}>Explore the docs <Icon name="arrow-up-right" size="sm" /></a>
        </div>
        <div class="workflow-steps">
          {project.steps.map((step, index) => (
            <div class="workflow-step"><span class="step-number">0{index + 1}</span><div><h3>{step.label}</h3><p>{step.detail}</p></div><Icon name="arrow-up-right" size="lg" /></div>
          ))}
        </div>
      </div>
    </section>

    <section id="media" class="project-section" aria-labelledby="media-title">
      <div class="project-shell">
        <div class="section-kicker">{sections.media.kicker}</div>
        <div class="section-heading"><h2 id="media-title">{lines(sections.media.heading)[0]}<br /><em>{lines(sections.media.heading)[1]}</em></h2><p>{sections.media.lead}</p></div>
        <div class="media-grid">
          <div class="media-tile large"><div class="media-tile-header"><Icon name="monitor" size="sm" /> DESKTOP CAPTURE <span>1440 × 900</span></div><div class="media-art screen-art"><div class="art-top"></div><div class="art-line thick"></div><div class="art-line"></div><div class="art-panels"><i></i><i></i><i></i></div></div></div>
          <div class="media-tile"><div class="media-tile-header"><Icon name="smartphone" size="sm" /> MOBILE <span>390 × 844</span></div><div class="media-art mobile-art"><div class="phone-outer"><div class="phone-header"></div><div class="phone-line"></div><div class="phone-line short"></div><div class="phone-button"></div></div></div></div>
          <div class="media-tile"><div class="media-tile-header"><Icon name="clapperboard" size="sm" /> VIDEO <span>MP4</span></div><div class="media-art video-art"><div class="play-orb"><Icon name="play" size="xl" /></div><div class="timeline"><span></span></div></div></div>
        </div>
        <p class="media-caption">{sections.media.caption} See the <a href={withBase('/docs/media/')}>media workflow docs</a>.</p>
      </div>
    </section>

    <section id="faq" class="project-section section-alt" aria-labelledby="faq-title">
      <div class="project-shell faq-grid"><div><div class="section-kicker">{sections.faq.kicker}</div><h2 id="faq-title">{sections.faq.heading}</h2><p class="section-lead">{sections.faq.lead}</p></div><div class="faq-list">{project.faqs.map((item) => (<details><summary>{item.question}<Icon name="plus" size="sm" /></summary><p>{item.answer}</p></details>))}</div></div>
    </section>

    <section class="project-final-cta" aria-labelledby="start-title"><div class="project-shell final-inner"><span class="section-kicker">{sections.cta.kicker}</span><h2 id="start-title">{lines(sections.cta.heading)[0]}<br />{lines(sections.cta.heading)[1]}</h2><p>{sections.cta.lead}</p><div class="hero-actions"><a class="project-button primary" href={withBase('/docs/getting-started/')}>{sections.cta.button} <Icon name="arrow-up-right" size="sm" /></a>{project.demoUrl && <a class="project-button secondary" href={project.demoUrl} target="_blank" rel="noopener noreferrer">Open live demo <Icon name="external-link" size="sm" /></a>}</div></div></section>
  </main>
</LandingLayout>
