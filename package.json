{
  "name": "single-project-site",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "description": "Single-project website with Starlight docs and automated visual media",
  "type": "module",
  "author": "Project team",
  "license": "MIT",
  "keywords": [
    "astro",
    "starlight",
    "documentation",
    "playwright",
    "vhs",
    "single-project",
    "website"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/YOUR_PROJECT"
  },
  "homepage": "https://github.com/YOUR_USERNAME/YOUR_PROJECT#readme",
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/YOUR_PROJECT/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:netlify": "DEPLOY_TARGET=netlify astro build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare astro build",
    "verify": "node scripts/verify-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm lint && pnpm check && pnpm build && pnpm check:site",
    "test": "vitest",
    "test:run": "vitest run",
    "media:capture": "node scripts/media/capture.mjs",
    "media:video": "node scripts/media/video.mjs",
    "check:site": "node scripts/check-site.mjs",
    "media:vhs": "node scripts/media/vhs.mjs",
    "media:all": "node scripts/media/all.mjs",
    "media:vhs:check": "node --test scripts/media/vhs.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.0",
    "@astrojs/react": "6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "@iconify-json/lucide": "^1.2.98",
    "@iconify-json/simple-icons": "^1.2.74",
    "@iconify/react": "^6.0.2",
    "astro": "7.4.12",
    "astro-icon": "^1.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fontkit": "^2.0.4",
    "lucide-react": "^0.563.0",
    "png-to-ico": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.9.3",
    "schema-dts": "^1.1.2",
    "sharp": "^0.34.0",
    "tailwind-merge": "^2.6.0",
    "@astrojs/starlight": "^0.43.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.0",
    "globals": "^15.14.0",
    "pagefind": "^1.3.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0",
    "playwright": "^1.65.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
